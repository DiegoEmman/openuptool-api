# ==============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openuptool
DB_USER=openuptool_user
DB_PASSWORD=your_secure_password_here

# ==============================================
# CONFIGURACIÓN DE PGADMIN
# ==============================================
PGADMIN_EMAIL=admin@openuptool.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ==============================================
# CONFIGURACIÓN DE JWT
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ISSUER=OpenUpTool
JWT_AUDIENCE=OpenUpToolUsers
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ==============================================
# CONFIGURACIÓN DE LA API
# ==============================================
API_PORT=5000
API_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ==============================================
# CONFIGURACIÓN DE LOGGING
# ==============================================
LOG_LEVEL=Information
LOG_PATH=logs

# ==============================================
# CONFIGURACIÓN DE SMTP (para notificaciones)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@openuptool.com
SMTP_FROM_NAME=OpenUpTool

# ==============================================
# CONFIGURACIÓN DE ALMACENAMIENTO DE ARCHIVOS
# ==============================================
STORAGE_TYPE=Local
STORAGE_PATH=uploads
MAX_FILE_SIZE_MB=50

# ==============================================
# CONFIGURACIÓN DE AZURE (opcional)
# ==============================================
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_STORAGE_CONTAINER=artifacts

# ==============================================
# CONFIGURACIÓN DE VERSIONES Y FEATURES
# ==============================================
API_VERSION=1.0.0
ENABLE_SWAGGER=true
ENABLE_AUDIT_LOG=true
ENABLE_RATE_LIMITING=true

# ==============================================
# CONFIGURACIÓN DE SEGURIDAD
# ==============================================
ENABLE_HTTPS_REDIRECT=false
ALLOWED_HOSTS=*
